# Copy to agent-v2/.env. Edit that local copy, never this shared example.
# Setup order: account + keys -> preset activation -> browser session -> run.
# See docs/INSTALL.md. Values already exported in the process environment
# take precedence over dotenv files; agent-v2/.env precedes the root .env.

# --- Your account (overrides the selected preset's account placeholders) ---
# Use the profile handle without @, not the publication's domain.
SUBSTACK_HANDLE=
NAZWA_MARKI=

# --- Model providers ---
# Required keys depend on the selected preset's model roles.
# The bundled AI and Hidden Bill presets use both providers below for text.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Used for optional article images. Hidden Bill disables images initially.
OPENAI_API_KEY=

# --- Operating modes ---
# true: skip model calls and block Substack writes; network reads may still run.
# Change to false only for a real model run. Publishing also needs --wyslij.
DRY_RUN=true

# Blocks model calls. To stop a running installation, stop its scheduler and
# processes; changing .env does not reload values in an existing process.
KILL_SWITCH=false

# --- Server ---
# Prefer the local Chrome CDP connection when available; otherwise the server
# path tries headless Chromium with the saved instance session. This variable
# alone does not install Chrome, a display or a scheduler.
# AGENT_V2_SERVER=1

# --- Optional model / budget overrides ---
# For plumbing experiments; inspect the resolved role map before use.
# AGENT_V2_CHEAP=1
# AGENT_V2_WRITER=claude-opus-5

# Disables monthly and daily thresholds; the per-run threshold still applies.
# Leave unset during normal operation.
# AGENT_V2_NO_LIMIT=1

# Database track: produkcja (default) or test. This is not a dry-run switch.
# AGENT_V2_TRYB=test

# --- Optional email alerts to the installation owner ---
ALARM_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
