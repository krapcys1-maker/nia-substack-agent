# Copy this file to agent-v2/.env and fill it in.
#
#   cp .env.example agent-v2/.env
#
# `agent-v2/.env` is gitignored and never reaches the repository. Never paste a
# key into a document, a log, a screenshot, or into this example file.
#
# THIS LIST IS DERIVED FROM THE CODE, not written from memory. The previous
# version of this file described a different, older agent: it was missing
# DEEPSEEK_API_KEY — which carries 21 of the 26 model roles — and listed seven
# variables that no line under agent-v2/ reads. Check it yourself:
#
#   grep -rn "_env(\|os.environ.get(" agent-v2/*.py

# --- API keys ---------------------------------------------------------------
# DeepSeek carries 21 of the 26 model roles. Without it the bot does almost
# nothing. Note that a missing key is only caught before the call for
# deepseek-v4-flash: the pre-flight check compares model ids rather than
# providers, so the 11 roles on deepseek-v4-pro fail as an HTTP error instead.
DEEPSEEK_API_KEY=

# Notes (Opus), the weekly article (Fable), and the repair pass.
ANTHROPIC_API_KEY=

# The article cover image ONLY, via https://api.openai.com/v1/images/...
# Leave empty and articles publish without a cover. Nothing else breaks.
OPENAI_API_KEY=

# --- modes ------------------------------------------------------------------
# DRY_RUN blocks model calls AND the browser. Keep it true until you have read
# docs/INSTALL.md — it used to block only model calls, and a "dry" run wrote
# nothing while still liking two strangers' posts.
DRY_RUN=true

# Hard stop. Nothing goes out while this is true.
KILL_SWITCH=false

# --- optional switches ------------------------------------------------------
# Headless server mode: the agent opens its own browser and loads the saved
# session instead of attaching to a Chrome a human started. All three systemd
# units set this.
# AGENT_V2_SERVER=1

# Everything on DeepSeek except discovery. For testing the PLUMBING — whether
# the chain runs, the JSON parses, the write lands — not for judging text.
# AGENT_V2_CHEAP=1

# Lifts the daily and monthly ceilings. The PER-RUN ceiling still applies.
# AGENT_V2_NO_LIMIT=1

# Swap only the article writer, for an A/B on the same evidence card.
# AGENT_V2_WRITER=claude-opus-5

# Database track: "produkcja" (default) or "test".
# AGENT_V2_TRYB=test

# --- alerts to the owner (email) --------------------------------------------
# The only channel the bot has for saying "something went wrong". Without it it
# still runs, just silently: an expired session would reach nobody.
# For Gmail, SMTP_PASSWORD is an APP PASSWORD, not your account password.
ALARM_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
